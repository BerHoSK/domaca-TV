<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The only permission: Open-Meteo, for the place search, the weather and the air quality. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Domáca TV: počasie pre launcher, len medzi aplikáciami s rovnakým podpisom. -->
    <permission android:name="sk.berho.domacatv.permission.RADIO_STATE"
        android:protectionLevel="signature" />
    <uses-permission android:name="sk.berho.domacatv.permission.RADIO_STATE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".WeatherActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md): the tile shows as "Weather" once the owner says Show. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
        <receiver android:name=".HomeWeatherReceiver" android:exported="true"
            android:permission="sk.berho.domacatv.permission.RADIO_STATE">
            <intent-filter>
                <action android:name="sk.berho.domacatv.weather.QUERY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
